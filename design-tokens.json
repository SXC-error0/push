{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "lamele-design-tokens",
  "version": "1.0.0",
  "description": "《拉了么》Design Tokens — 可导入 Figma Tokens / Style Dictionary / Stitch DESIGN.md",

  "color": {
    "cream": { "$value": "#FFF8F0", "description": "页面背景" },
    "warmWhite": { "$value": "#FFFBF5", "description": "卡片表面" },
    "mint": { "$value": "#A5D6A7", "description": "主色-浅" },
    "mintDark": { "$value": "#66BB6A", "description": "主色-深/主按钮" },
    "apricot": { "$value": "#FFB74D", "description": "辅助强调" },
    "sky": { "$value": "#81D4FA", "description": "辅助信息" },
    "textPrimary": { "$value": "#4E342E", "description": "主文字" },
    "textMuted": { "$value": "#8D6E63", "description": "辅助文字" },
    "textOnPrimary": { "$value": "#FFFFFF", "description": "主色上文字" },
    "success": { "$value": "#66BB6A", "description": "成功状态" },
    "warning": { "$value": "#FFB74D", "description": "警告状态" },
    "danger": { "$value": "#EF9A9A", "description": "危险/异常（柔化）" },
    "cyber": {
      "bg": { "$value": "#1A1A2E", "description": "赛博模式背景" },
      "surface": { "$value": "#16213E", "description": "赛博模式卡片" },
      "neon": { "$value": "#00FF88", "description": "赛博模式高亮" },
      "accent": { "$value": "#FF6B6B", "description": "赛博模式警戒" },
      "muted": { "$value": "#7B8D9E", "description": "赛博模式次要" }
    }
  },

  "typography": {
    "fontFamily": {
      "heading": { "$value": "'ZCOOL KuaiLe', cursive, sans-serif" },
      "body": { "$value": "system-ui, -apple-system, sans-serif" },
      "mono": { "$value": "'JetBrains Mono', monospace" }
    },
    "scale": {
      "xs": { "$value": { "fontSize": "12sp", "lineHeight": "16sp", "fontWeight": 400 } },
      "sm": { "$value": { "fontSize": "14sp", "lineHeight": "20sp", "fontWeight": 400 } },
      "base": { "$value": { "fontSize": "16sp", "lineHeight": "24sp", "fontWeight": 400 } },
      "lg": { "$value": { "fontSize": "18sp", "lineHeight": "26sp", "fontWeight": 500 } },
      "xl": { "$value": { "fontSize": "22sp", "lineHeight": "30sp", "fontWeight": 600 } },
      "2xl": { "$value": { "fontSize": "28sp", "lineHeight": "36sp", "fontWeight": 700 } },
      "3xl": { "$value": { "fontSize": "36sp", "lineHeight": "44sp", "fontWeight": 800 } }
    }
  },

  "spacing": {
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "32px" }
  },

  "borderRadius": {
    "sm": { "$value": "8px", "description": "标签/徽章" },
    "md": { "$value": "12px", "description": "输入框" },
    "lg": { "$value": "16px", "description": "标准卡片" },
    "xl": { "$value": "20px", "description": "Chip 标签" },
    "2xl": { "$value": "24px", "description": "主按钮" },
    "full": { "$value": "9999px", "description": "头像/圆形" }
  },

  "shadow": {
    "sm": { "$value": "0 1px 4px rgba(78,52,46,0.06)" },
    "md": { "$value": "0 2px 12px rgba(78,52,46,0.08)" },
    "lg": { "$value": "0 4px 20px rgba(102,187,106,0.20)" },
    "xl": { "$value": "0 8px 32px rgba(78,52,46,0.12)" }
  },

  "animation": {
    "easing": {
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "bounce": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" },
      "inOut": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
    },
    "duration": {
      "instant": { "$value": "100ms" },
      "fast": { "$value": "200ms" },
      "normal": { "$value": "350ms" },
      "slow": { "$value": "500ms" },
      "celebration": { "$value": "800ms" }
    }
  },

  "component": {
    "primaryButton": {
      "height": "52px",
      "borderRadius": "24px",
      "background": "{color.mintDark}",
      "color": "white",
      "shadow": "{shadow.lg}"
    },
    "secondaryButton": {
      "height": "48px",
      "borderRadius": "24px",
      "background": "{color.mint} at 30% opacity",
      "color": "{color.mintDark}"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "14px",
      "background": "{color.warmWhite}",
      "shadow": "{shadow.md}"
    },
    "filterChip": {
      "borderRadius": "20px",
      "padding": "8px 12px",
      "selectedBg": "{color.mintDark}",
      "unselectedBg": "{color.cream}"
    },
    "textField": {
      "borderRadius": "12px",
      "border": "1px solid {color.mint}",
      "focusBorder": "1px solid {color.mintDark}"
    }
  }
}
